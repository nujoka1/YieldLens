# Copy to .env before starting. Replace every change-me value.
COMPOSE_PROJECT_NAME=yieldlens
YIELDLENS_ENV=development
LOG_LEVEL=INFO

# Kafka (internal Docker address; host clients use localhost:29092)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_IOT=yieldlens.iot.telemetry.v1
KAFKA_TOPIC_CLIMATE=yieldlens.climate.daily.v1
KAFKA_TOPIC_FAOSTAT=yieldlens.faostat.annual.v1
KAFKA_TOPIC_PARTITIONS=6

# MinIO / S3
MINIO_ROOT_USER=yieldlens_admin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_CONSOLE_PORT=19001
MINIO_RAW_BUCKET=yieldlens-raw
MINIO_CURATED_BUCKET=yieldlens-curated

# PostgreSQL
POSTGRES_DB=yieldlens
POSTGRES_USER=yieldlens_app
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Spark standalone cluster
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=512m
